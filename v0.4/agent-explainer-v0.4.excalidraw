    { "id": "q_rem_t", "type": "text", "x": 85, "y": 693, "width": 1200, "height": 100, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 430, "version": 1, "versionNonce": 430, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "REMEMBER:\n1. a tool = name + description + schema — the model can't tell fake from real\n2. MCP is a standard plug for tools someone else wrote — one config dict gave us 14\n3. MCP tools are async — invoke became ainvoke, the loop itself is unchanged", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "REMEMBER:\n1. a tool = name + description + schema — the model can't tell fake from real\n2. MCP is a standard plug for tools someone else wrote — one config dict gave us 14\n3. MCP tools are async — invoke became ainvoke, the loop itself is unchanged", "lineHeight": 1.25 }
