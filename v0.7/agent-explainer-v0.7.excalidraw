      "updated": 1,
      "link": null,
      "locked": false,
      "text": "# no weather code in the agent AT ALL \u2014 just an MCP client:\nclient = MultiServerMCPClient({\"gateway\": {\n    \"transport\": \"streamable_http\",\n    \"url\": os.getenv(\"AGENTCORE_GATEWAY_WEATHERGATEWAY_URL\")}})\ntools = await client.get_tools()\n# -> ['GeoAPI___geocodeCity', 'ForecastTool___getCurrentWeather']",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# no weather code in the agent AT ALL \u2014 just an MCP client:\nclient = MultiServerMCPClient({\"gateway\": {\n    \"transport\": \"streamable_http\",\n    \"url\": os.getenv(\"AGENTCORE_GATEWAY_WEATHERGATEWAY_URL\")}})\ntools = await client.get_tools()\n# -> ['GeoAPI___geocodeCity', 'ForecastTool___getCurrentWeather']",
      "lineHeight": 1.25
    },
