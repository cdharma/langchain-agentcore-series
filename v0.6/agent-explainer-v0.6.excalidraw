      "updated": 1,
      "link": null,
      "locked": false,
      "text": "checkpointer = AgentCoreMemorySaver(MEMORY_ID)     # short-term\nstore = AgentCoreMemoryStore(memory_id=MEMORY_ID)  # long-term\n\ngraph = create_react_agent(model, tools=tools,\n    checkpointer=checkpointer,  # persisted conversation state\n    store=store,                # extraction + semantic search\n    pre_model_hook=pre_model_hook)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "checkpointer = AgentCoreMemorySaver(MEMORY_ID)     # short-term\nstore = AgentCoreMemoryStore(memory_id=MEMORY_ID)  # long-term\n\ngraph = create_react_agent(model, tools=tools,\n    checkpointer=checkpointer,  # persisted conversation state\n    store=store,                # extraction + semantic search\n    pre_model_hook=pre_model_hook)",
      "lineHeight": 1.25
    },
