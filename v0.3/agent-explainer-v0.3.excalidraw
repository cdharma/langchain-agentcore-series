    { "id": "m_wire_t", "type": "text", "x": 85, "y": 652, "width": 1100, "height": 50, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 321, "version": 1, "versionNonce": 321, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "the wire is STILL stateless — every turn resends the full history (v0.1 rule holds);\nmemory lives in YOUR process, inside the checkpointer — the model remembers nothing", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "the wire is STILL stateless — every turn resends the full history (v0.1 rule holds);\nmemory lives in YOUR process, inside the checkpointer — the model remembers nothing", "lineHeight": 1.25 },

    { "id": "m_rem_r", "type": "rectangle", "x": 60, "y": 750, "width": 1150, "height": 125, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "#ffc9c9", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": { "type": 3 }, "seed": 322, "version": 1, "versionNonce": 322, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false },
    { "id": "m_rem_t", "type": "text", "x": 85, "y": 763, "width": 1100, "height": 100, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 323, "version": 1, "versionNonce": 323, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "REMEMBER:\n1. memory = replayed messages — the model itself remembers nothing between calls\n2. thread_id is the conversation key — switch it, fresh brain\n3. InMemorySaver dies with the process — persistent memory arrives with AgentCore (v0.6+)", "fontSize": 20, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "REMEMBER:\n1. memory = replayed messages — the model itself remembers nothing between calls\n2. thread_id is the conversation key — switch it, fresh brain\n3. InMemorySaver dies with the process — persistent memory arrives with AgentCore (v0.6+)", "lineHeight": 1.25 }
